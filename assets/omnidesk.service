[Unit]
Description=OmniDesk - Sincronização P2P de Clipboard e Arquivos
Documentation=https://github.com/thyagoluciano/omnidesk
PartOf=graphical-session.target
After=graphical-session.target network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omnidesk daemon
Restart=on-failure
RestartSec=3s
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

[Install]
WantedBy=default.target
