# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.desktop text eol=lf
*.service text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Binary files - prevent Git from modifying line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.svg text eol=lf
*.pdf binary
*.deb binary
*.dmg binary
*.exe binary
*.zip binary
*.tar.gz binary
